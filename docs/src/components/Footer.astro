---
/**
 * Custom Footer for SaltyKeys.js documentation
 * Overrides the default Starlight footer
 */
---

<footer>
	<div class="footer-content">
		<p>
			Built by <a href="https://peterbenoit.com" class="author-link">Peter Benoit</a>. &copy; 2026.
		</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--sl-color-gray-5);
		margin-top: 4rem;
		padding-top: 2.5rem;
		padding-bottom: 2.5rem;
	}

	.footer-content {
		max-width: 72rem;
		margin-left: auto;
		margin-right: auto;
		padding-left: 1rem;
		padding-right: 1rem;
		text-align: center;
	}

	.footer-content p {
		color: var(--sl-color-gray-3);
		font-size: 0.875rem;
		margin: 0;
	}

	.author-link {
		color: var(--sl-color-text-accent);
		font-weight: 500;
		text-decoration: none;
		transition: color 0.2s;
	}

	.author-link:hover {
		color: var(--sl-color-white);
	}

	@media (prefers-color-scheme: light) {
		.author-link:hover {
			color: var(--sl-color-black);
		}
	}
</style>
